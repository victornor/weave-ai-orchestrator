{
  "name": "agent-conductor",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "typecheck": "tsc -b tsconfig.json && pnpm --filter @agent-conductor/ui typecheck",
    "test": "node scripts/test.mjs",
    "lint": "node scripts/guard-boundaries.mjs && node scripts/guard-console.mjs",
    "dev": "pnpm --filter @agent-conductor/server run dev",
    "conductor": "node packages/cli/dist/bin.js"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "tsx": "^4.20.5",
    "@types/node": "^24.5.2"
  }
}
