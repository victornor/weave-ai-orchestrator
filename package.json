{
  "name": "weave-ai",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "typecheck": "tsc -b tsconfig.json && pnpm --filter @weave-ai/ui typecheck",
    "test": "node scripts/test.mjs",
    "lint": "node scripts/guard-boundaries.mjs && node scripts/guard-console.mjs && node scripts/guard-test-fixtures.mjs",
    "dev": "pnpm --filter @weave-ai/server run dev",
    "weave": "node packages/cli/dist/bin.js",
    "demo:screenshots": "node scripts/demo-screenshots.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "demo:readme-images": "node scripts/demo-readme-images.mjs",
    "demo": "node packages/server/dist/bin.js --demo"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "playwright-core": "^1.63.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
