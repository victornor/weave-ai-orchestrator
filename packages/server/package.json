    "@openconductor/surface-sdk": "workspace:*",
    "@openconductor/plugin-sdk": "workspace:*",
    "@openconductor/runtime-claude": "workspace:*",
    "@openconductor/runtime-codex": "workspace:*",
    "@openconductor/runtime-opencode": "workspace:*",
    "@openconductor/runtime-gemini": "workspace:*",
    "@openconductor/channel-web": "workspace:*",
    "@openconductor/channel-cli": "workspace:*",
    "@openconductor/channel-telegram": "workspace:*",
    "hono": "^4.9.6",
    "@hono/node-server": "^1.19.1",
    "@modelcontextprotocol/sdk": "^1.18.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.5",
